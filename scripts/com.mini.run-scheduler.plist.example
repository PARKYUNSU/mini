<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 참고용. 실제 설치: bash scripts/install-run-scheduler-launchagent.sh (경로 자동 생성) -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mini.run-scheduler</string>
	<key>ProgramArguments</key>
	<array>
		<string>/path/to/mini/.venv/bin/python</string>
		<string>/path/to/mini/run_scheduler.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/path/to/mini</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/path/to/mini/.cron/launchd-scheduler.log</string>
	<key>StandardErrorPath</key>
	<string>/path/to/mini/.cron/launchd-scheduler.err.log</string>
</dict>
</plist>
