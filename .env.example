# Gemini API 키 (Q&A 생성용)
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=your_api_key_here

# 텔레그램 봇 (RAG 봇과 Agent 봇은 각각 별도 토큰 사용 권장)
# @BotFather에서 /newbot 으로 각각 발급
RAG_BOT_TOKEN=your_rag_bot_token_here
AGENT_BOT_TOKEN=your_agent_bot_token_here
# 둘 다 없으면 TELEGRAM_TOKEN 사용 (한 번에 하나의 봇만 실행 가능)
TELEGRAM_TOKEN=your_bot_token_here
# @userinfobot 또는 @getmyid_bot 으로 확인한 내 Chat ID
ALLOWED_CHAT_ID=your_chat_id_here

# E2B 샌드박스 (코드 실행 격리)
# https://e2b.dev/dashboard 에서 발급
E2B_API_KEY=your_e2b_api_key_here
