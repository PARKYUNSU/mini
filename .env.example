# --- test_agent_flow.py / Executor·Monitor 통합 점검에 쓰는 최소 셋 ---
# (아래는 위 항목과 동일 변수이며, 로컬에서 한 번에 채우기 위한 안내입니다.)
#   LOCAL_LLM_MODEL=qwen3.5:9b   +  ollama serve
#   GEMINI_API_KEY=...  GROQ_API_KEY=...
#   E2B_API_KEY=...
# 선택: Chroma(3번) — 임베딩 모델은 첫 실행 시 HF 캐시에 내려받음
#   python scripts/check_agent_env.py --keys --services --models

# Gemini API 키 (라우터 폴백·도구 선택·Tavily 요약·LLM 토론 비평 등)
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=your_api_key_here
# 429/쿼터 초과 시 자동으로 다음 키 사용 (둘 중 하나만 쓰면 됨)
#   A) GEMINI_API_KEY + GEMINI_API_KEY_2 … _8 (비어 있는 번호는 건너뜀, 순서대로 시도)
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# GEMINI_API_KEY_6=
# GEMINI_API_KEY_7=
# GEMINI_API_KEY_8=
#   B) GEMINI_API_KEYS=key1,key2,... — 비어 있지 않으면 이 목록만 사용 (개수 제한 없음, A 무시)

# agent_bot만 켤 때도 스케줄(cron_engine)을 돌리려면 1(기본). run_scheduler와 중복 실행은 파일 락으로 막음.
# AGENT_BOT_CRON_WORKER=0

# 텔레그램 /debate_start 논문 토론: 최대 실행 시간(초). 0 이하 = 시간 제한 없음(기본 0)
# LLM_DEBATE_TELEGRAM_DURATION_SEC=14400
# run_scheduler 월~금 02:00 토론 배치: 0 이하 = 무제한(기본 0) → 백그라운드 기동, 로그 .cron/llm_debate_batch_stdout.log. PID는 .cron/llm_debate_child.pid(+ .llm_debate.telegram.pid 미러), 스케줄·텔레그램 공통 중복 가드(llm_debate_spawn_guard)
# LLM_DEBATE_BATCH_DURATION_SEC=7200

# 텔레그램 /backfill_start 분기 백필 기본값
# BACKFILL_YEAR=2024
# BACKFILL_CATEGORY=cs.AI
# BACKFILL_BATCH_SIZE=15
# BACKFILL_TIME_LIMIT_SEC=7200
# BACKFILL_CONTINUE_ON_ERROR=1

# 토론 배치 heartbeat/health (운영 관측/장애 탐지)
# - heartbeat 파일: .cron/llm_debate_health.json (최근 업데이트 시각/상태)
# - max stale(기본 15분) 초과 시, spawn 가드는 "장애 상태로 판단"하고 PID 파일을 정리한 뒤 다음 기동을 허용
# LLM_DEBATE_HEARTBEAT_INTERVAL_SEC=60
# LLM_DEBATE_HEARTBEAT_MAX_STALE_SEC=900

# Groq API 키 (Executor/Monitor 코딩·검수 전용)
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# 선택: 기본 meta-llama/llama-4-scout-17b-16e-instruct 대신 다른 Groq 모델
# GROQ_CODING_MODEL=meta-llama/llama-3.3-70b-versatile

# 텔레그램 봇 (메인 봇 agent_bot.py 전용)
# @BotFather에서 /newbot 으로 발급
TELEGRAM_TOKEN=your_bot_token_here
# @userinfobot 또는 @getmyid_bot 으로 확인한 내 Chat ID
ALLOWED_CHAT_ID=your_chat_id_here

# 로컬 LLM (Ollama) - Router, Planner, RAG, LLM 토론 등
# 기본값: qwen3.5:9b (없으면 이 값 사용)
LOCAL_LLM_MODEL=qwen3.5:9b
# 일상(A)·RAG(B) 직접 답변 공통 LLM 타임아웃(초). 0 이하 = 무제한(기본 55)
# DIRECT_ANSWER_TIMEOUT_SEC=55

# E2B 샌드박스 (코드 실행 격리)
# https://e2b.dev/dashboard 에서 발급
E2B_API_KEY=your_e2b_api_key_here

# OpenWeatherMap (날씨 API)
# https://openweathermap.org/api 에서 발급
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Tuya 스마트 플러그 (agent_tools/smart_plug.py)
# local(기본)=LAN TCP 6668 / cloud=IoT API (앱과 같은 경로, LAN 포트 불필요)
# TUYA_CONTROL_MODE=local
# TUYA_CONTROL_MODE=cloud
# TUYA_CLOUD_ACCESS_ID=
# TUYA_CLOUD_ACCESS_SECRET=
# TUYA_CLOUD_REGION=us
# TUYA_CLOUD_DP_CODE=switch_1
# IoT 개발자 센터 / tinytuya wizard 로 device_id, local_key 확보
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_PLUG_IP=192.168.0.20
# TUYA_PLUG_PORT=6668
TUYA_PROTOCOL_VERSION=3.3
# 스위치가 DPS 1이 아닌 기기만 (기본 1)
# TUYA_PLUG_DPS=1
# 상태 조회(901) 문제 시: 제어 후 대기 초 늘리기 / 엄격 오류 모드
# TUYA_PLUG_STATUS_DELAY=2
# TUYA_PLUG_STRICT_VERIFY=0
# TUYA_PLUG_RELAX_VERIFY=1
# 선택: 연결 대기가 길면 타임아웃·재시도 줄이기 (기본 8초, 재시도 2)
# TUYA_SOCKET_TIMEOUT=8
# TUYA_SOCKET_RETRIES=2
