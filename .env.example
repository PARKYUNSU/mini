# Gemini API 키 (Q&A 생성용)
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=your_api_key_here

# 텔레그램 봇 (메인 봇 agent_bot.py 전용)
# @BotFather에서 /newbot 으로 발급
TELEGRAM_TOKEN=your_bot_token_here
# @userinfobot 또는 @getmyid_bot 으로 확인한 내 Chat ID
ALLOWED_CHAT_ID=your_chat_id_here

# 로컬 LLM (Ollama) - Router, Planner, RAG, LLM 토론 등
# 기본값: qwen3.5:9b (없으면 이 값 사용)
LOCAL_LLM_MODEL=qwen3.5:9b

# E2B 샌드박스 (코드 실행 격리)
# https://e2b.dev/dashboard 에서 발급
E2B_API_KEY=your_e2b_api_key_here

# OpenWeatherMap (날씨 API)
# https://openweathermap.org/api 에서 발급
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
