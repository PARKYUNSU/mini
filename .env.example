# --- test_agent_flow.py / Executor·Monitor 통합 점검에 쓰는 최소 셋 ---
# (아래는 위 항목과 동일 변수이며, 로컬에서 한 번에 채우기 위한 안내입니다.)
#   LOCAL_LLM_MODEL=qwen3.5:9b   +  ollama serve
#   GEMINI_API_KEY=...  GROQ_API_KEY=...
#   E2B_API_KEY=...
# 선택: Chroma(3번) — 임베딩 모델은 첫 실행 시 HF 캐시에 내려받음
#   python scripts/check_agent_env.py --keys --services --models
#
# 저장 경로를 맥 미니 내장 대신 T7 외장으로 통일할 때 (mini/.env 에서 설정):
#   1) 스케줄러·텔레그램 봇·워커 등 Chroma 를 쓰는 프로세스 중지
#   2) 기존 DB 폴더를 rsync 등으로 T7 아래로 복사 (예: ~/Library/Application Support/mini-chroma → 아래 chroma_db)
#   3) 검증 후 내장 쪽은 삭제하거나 이름만 바꿔 백업 보관
# CHROMA_DB_PATH=/Volumes/T7 Shield/mini/chroma_db
# TOOL_CHROMA_DB_PATH=/Volumes/T7 Shield/mini/tool_chroma_db
# PDF 처리 시 내장 /tmp 부담을 줄이려면 LaunchAgent/셸에서: export TMPDIR=/Volumes/T7 Shield/mini/tmp
# LaunchAgent WorkingDirectory 는 항상 /Volumes/T7 Shield/mini 로 두면 raw_data_queue·체크포인트도 T7 기준으로 맞춰짐.

# Gemini API 키 (라우터 폴백·도구 선택·Tavily 요약·LLM 토론 비평 등)
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=your_api_key_here
# 일일 arXiv 파이프라인 시각 (`apps.scheduler.run_scheduler`, Gemini 키 있을 때만 등록). 기본 01:00
# ARXIV_PIPELINE_SCHEDULE_AT=01:00
# ingest 메타 스캔 폭 (중복만 나올 때 신규를 더 찾으려면 MAX_SCAN 증가)
# ARXIV_INGEST_BATCH_SIZE=50
# ARXIV_INGEST_MAX_SCAN=200
# ARXIV_INGEST_TARGET_NEW=0
# ingest 메타 페이징: 페이지 사이 추가 대기(초, 기본 18). 429 잦으면 25~60 권장
# ARXIV_INGEST_PAGE_SLEEP_SEC=25
# 각 API 호출 전 랜덤 지연 범위(초)
# ARXIV_INGEST_MIN_DELAY_SEC=6
# ARXIV_INGEST_MAX_DELAY_SEC=14
# arXiv export 429 시 동일 페이지 재시도 (백필과 공통)
# ARXIV_429_BACKOFF_SEC=180
# ARXIV_429_MAX_RETRY=12
# 429/쿼터 초과 시 자동으로 다음 키 사용 (둘 중 하나만 쓰면 됨)
#   A) GEMINI_API_KEY + GEMINI_API_KEY_2 … _8 (비어 있는 번호는 건너뜀, 순서대로 시도)
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# GEMINI_API_KEY_6=
# GEMINI_API_KEY_7=
# GEMINI_API_KEY_8=
#   B) GEMINI_API_KEYS=key1,key2,... — 비어 있지 않으면 이 목록만 사용 (개수 제한 없음, A 무시)

# agent_bot만 켤 때도 스케줄(cron_engine)을 돌리려면 1(기본). run_scheduler와 중복 실행은 파일 락으로 막음.
# AGENT_BOT_CRON_WORKER=0

# 텔레그램 /debate_start 논문 토론: 최대 실행 시간(초). 0 이하 = 시간 제한 없음(기본 0)
# LLM_DEBATE_TELEGRAM_DURATION_SEC=14400
# 월~금 02:00 파인튜닝용 논문 토론 배치(llm_debate_scheduler). 기본 꺼짐 — 켜려면 1
# LLM_DEBATE_SCHEDULE_ENABLED=1
# run_scheduler 월~금 02:00 토론 배치: 0 이하 = 무제한(기본 0) → 백그라운드 기동, 로그 .cron/llm_debate_batch_stdout.log. PID는 .cron/llm_debate_child.pid(+ .llm_debate.telegram.pid 미러), 스케줄·텔레그램 공통 중복 가드(llm_debate_spawn_guard)
# LLM_DEBATE_BATCH_DURATION_SEC=7200

# 텔레그램 /backfill_start 분기 백필 기본값
# BACKFILL_YEAR=2024
# BACKFILL_CATEGORY=cs.AI
# BACKFILL_BATCH_SIZE=15
# BACKFILL_TIME_LIMIT_SEC=7200
# BACKFILL_CONTINUE_ON_ERROR=1

# 토론 배치 heartbeat/health (운영 관측/장애 탐지)
# - heartbeat 파일: .cron/llm_debate_health.json (최근 업데이트 시각/상태)
# - max stale(기본 15분) 초과 시, spawn 가드는 "장애 상태로 판단"하고 PID 파일을 정리한 뒤 다음 기동을 허용
# LLM_DEBATE_HEARTBEAT_INTERVAL_SEC=60
# LLM_DEBATE_HEARTBEAT_MAX_STALE_SEC=900

# Groq API 키 (Executor/Monitor 코딩·검수 전용)
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# 선택: 기본 openai/gpt-oss-120b 대신 다른 Groq 모델 (Llama 계열은 2026-09 Groq에서 제거됨)
# GROQ_CODING_MODEL=qwen/qwen3.8-27b

# 텔레그램 봇 (메인 봇 agent_bot.py 전용)
# @BotFather에서 /newbot 으로 발급
TELEGRAM_TOKEN=your_bot_token_here
# @userinfobot 또는 @getmyid_bot 으로 확인한 내 Chat ID
ALLOWED_CHAT_ID=your_chat_id_here

# 로컬 LLM (Ollama) - Router, Planner, RAG, LLM 토론 등
# 기본값: qwen3.5:9b (없으면 이 값 사용)
LOCAL_LLM_MODEL=qwen3.5:9b
# RAG 답변(B) 전용 로컬 모델 (미설정 시 LOCAL_LLM_MODEL). 실험 결과 RAG 는 파인튜닝 모델이, 나머지 슬롯은 base 가 나음
# → 잡담·계획은 base, RAG 만 yunsur_v4 (docs/experiments/yunsur_v4/05_conclusion.md). 두 모델을 번갈아 로드하므로 RAG 첫 응답이 수 초 느려질 수 있음
# RAG_ANSWER_MODEL=yunsur_v4
# Boardroom 하이브리드 (swarm_meeting): CTO·QA·토론 압축 = API(Haiku / Gemini Flash), 회의록만 LOCAL_LLM_MODEL(Ollama·윤수르)
# BOARDROOM_CTO_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# BOARDROOM_DIGEST_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# BOARDROOM_DISCUSSION_GEMINI_MODEL=gemini-2.0-flash   # CTO 폴백·QA·압축(Gemini) 공통 (미설정 시 GEMINI_MODEL)
# BOARDROOM_QA_GEMINI_MODEL=gemini-2.0-flash           # QA만 다른 모델을 쓰고 싶을 때
# BOARDROOM_DIGEST_MAX_CHARS=2000
# BOARDROOM_DIGEST_INPUT_MAX_CHARS=120000
# BOARDROOM_API_TIMEOUT_SEC=900
# 회의록(Ollama) 한 컨텍스트 창 — 길 입력 보호 (압축본만 넣으므로 기본 여유)
# 일상(A)·RAG(B) 직접 답변 공통 LLM 타임아웃(초). 0 이하 = 무제한(기본 55)
# DIRECT_ANSWER_TIMEOUT_SEC=55

# Anthropic Claude (Phase 4 Boardroom ``swarm_meeting``: CTO 압축·Coder 노드)
# https://console.anthropic.com/ — 표준 이름 권장
# ANTHROPIC_API_KEY=sk-ant-api03-...
# (호환) CLAUDE_API_KEY=...  또는 ANTHROPIC_KEY=...
# 선택: ``BOARDROOM_CLAUDE_MODEL`` (미설정 시 Sonnet 4.5 → Sonnet 4 → Haiku 4.5 순으로 404 시 폴백)
# 통합 스케줄러: morning_scraper → Phase35 YES 심사·브리핑 (시스템 crontab과 중복 등록 금지)
# PHASE35_SCHEDULE_ENABLED=1
# MORNING_SCRAPER_SCHEDULE_AT=07:30
# 뉴스: TechCrunch·HN 영문 RSS 포함하려면 1 (기본 0=한글 중심)
# MORNING_NEWS_EN_FEEDS=0
# Ollama 뉴스 요약 후 한국어 정제 2차 패스 (기본 1)
# MORNING_NEWS_ALWAYS_POLISH=1
# Phase35 arXiv: 쉼표 구분 카테고리. 당일(GMT) 단독 0건이면 최근 N일 폴백
# CURATOR_ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
# CURATOR_FALLBACK_DAY_SPAN=7
# export.arxiv.org 메타 요청 타임아웃(초, 기본 120). 느린 회선·HTTPS 지연 시 상향
# ARXIV_API_TIMEOUT_SEC=120
# PHASE35_CURATOR_SCHEDULE_AT=08:00
# 통합 스케줄러(``apps.scheduler.run_scheduler``)로 Boardroom 자동 기동할 때
# BOARDROOM_SCHEDULE_ENABLED=1
# BOARDROOM_SCHEDULE_AT=10:00
# 미설정 시 주말 포함 **매일** 동일 시각. 월~금만이면 0
# BOARDROOM_SCHEDULE_DAILY=0
# (스케줄 자식에만) YES 없으면 아래 돌지 않음 — 수동 실행에는 영향 없음
# BOARDROOM_SCHEDULE_SKIP_IF_NO_YES=1
# 통합 스케줄러 메인 루프 폴링(초, 기본 30). 예약 시각 부근 재김이 더 촘촘해짐.
# SCHEDULER_POLL_SEC=30
# 파인튜닝용 LLM 논문 토론 배치(월~금 02:00). 기본 꺼짐 — 켜려면 1
# LLM_DEBATE_SCHEDULE_ENABLED=0
# 이미 Boardroom을 진행한 논문은 안건에서 제외 (기본 1). 같은 논문으로 다시 돌리려면 0
# BOARDROOM_SKIP_ALREADY_COMPLETED=1
# minutes_node 전용(Ollama·윤수르): 앞 단계 API 압축본(~2K)·메타만 입력
# BOARDROOM_MINUTES_TEMPERATURE=0.5
# BOARDROOM_MINUTES_REPEAT_PENALTY=1.2
# BOARDROOM_MINUTES_REPEAT_LAST_N=2048
# Ollama 회의록: 출력 토큰 **강제 상한** (기본 300, 반복 붕괴 시에도 강제 종료)
# BOARDROOM_MINUTES_MAX_PREDICT=300
# (호환) BOARDROOM_MINUTES_NUM_PREDICT=300
# (레거시; 하이브리드에서는 회의록이 압축본 중심) 토론 끝 2턴만 쓰는 구 설정 호환
# BOARDROOM_MINUTES_OLLAMA_PER_MSG_CHARS=2000
# BOARDROOM_MINUTES_OLLAMA_MAX_CHARS=3500
# (옛) BOARDROOM_MINUTES_PER_TURN_CHARS=12000

# E2B 샌드박스 (코드 실행 격리)
# https://e2b.dev/dashboard 에서 발급
E2B_API_KEY=your_e2b_api_key_here

# OpenWeatherMap (날씨 API)
# https://openweathermap.org/api 에서 발급
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Tuya 스마트 플러그 (agent_tools/smart_plug.py)
# local(기본)=LAN TCP 6668 / cloud=IoT API (앱과 같은 경로, LAN 포트 불필요)
# TUYA_CONTROL_MODE=local
# TUYA_CONTROL_MODE=cloud
# TUYA_CLOUD_ACCESS_ID=
# TUYA_CLOUD_ACCESS_SECRET=
# TUYA_CLOUD_REGION=us
# TUYA_CLOUD_DP_CODE=switch_1
# IoT 개발자 센터 / tinytuya wizard 로 device_id, local_key 확보
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_PLUG_IP=192.168.0.20
# TUYA_PLUG_PORT=6668
TUYA_PROTOCOL_VERSION=3.3
# 스위치가 DPS 1이 아닌 기기만 (기본 1)
# TUYA_PLUG_DPS=1
# 상태 조회(901) 문제 시: 제어 후 대기 초 늘리기 / 엄격 오류 모드
# TUYA_PLUG_STATUS_DELAY=2
# TUYA_PLUG_STRICT_VERIFY=0
# TUYA_PLUG_RELAX_VERIFY=1
# 선택: 연결 대기가 길면 타임아웃·재시도 줄이기 (기본 8초, 재시도 2)
# TUYA_SOCKET_TIMEOUT=8
# TUYA_SOCKET_RETRIES=2
