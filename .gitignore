# 환경 변수 (API 키 포함)
# `.env` 만 막혀 있어 `.env.bak-<타임스탬프>` 백업(키 26개)이 새어나올 수 있었다.
# `.env.example` 은 계속 추적한다 (아래 패턴에 걸리지 않음).
.env
.env.bak*
.env.*.bak
.env.local
.env.*.local

# 가상환경
.venv/

# 백필 런타임 상태
.backfill.pid
.backfill_*.pid
.llm_debate.telegram.pid
.cron/cron_worker.lock
.cron/cron_worker_stdout.log
.backfill.start_count

# 로컬 크론 잡 상태 (jobs.json 등)
.cron/

# agent_bot 단일 인스턴스 flock (내용은 PID, 잠금은 FD로만 유효)
.agent_bot_singleton.lock

# 분리 모드 (telegram_receiver + ai_worker) 런타임
.telegram_receiver.lock
.telegram_receiver.pid
.ai_worker.lock
.ai_worker.pid
.phase3_telegram_bot.pid
idea_vault.sqlite
.bridge/

# 출력 데이터
raw_data_queue/
# Boardroom 이 날마다 쓰는 회의록 산출물 (소스가 아니라 결과)
archives/
finetune_datasets/*
!finetune_datasets/v4/
finetune_datasets/v4/raw/
!finetune_datasets/v5/
finetune_datasets/v5/raw/
!finetune_datasets/v6/
!finetune_datasets/v9/
!finetune_datasets/v12/
!finetune_datasets/v13/
# 운영 프롬프트 원본(7MB) — 쓰인 400건은 train_data_v12.jsonl 에 그대로 들어 있다
finetune_datasets/v12/prompts.jsonl
chroma_db/
chroma_db_backup_*/
# 점(.) 구분자라 chroma_db_backup_* 에 걸리지 않는다 — 마이그레이션 전 스냅샷
chroma_db.pre-migrate-*/
# 임베딩·검색 실험용 일회성 DB
chroma_db_test/
chroma_db_emb_test/
chroma_zero_test/
tool_chroma_db/
check_chroma.py
test_chroma_minimal.py
test_chroma_query.py
agent_checkpoints.db
agent_checkpoints.db-shm
agent_checkpoints.db-wal
chat_memory.db
*.log
morning_cache.json

# 기전 라운드가 만든 일회성 체크포인트 Modelfile (checkpoint_1004 · template_collapse_1006).
# FROM 줄만 빼면 추적 중인 Modelfile.v5~v11 과 **바이트 동일**하다 — TEMPLATE/PARAMETER
# 라는 측정 조건은 이미 그쪽에 담겨 있으므로 11개를 더 추적해도 얻는 것이 없다.
Modelfile.ckpt*
Modelfile.s0*

# macOS
.DS_Store

# 테스트 결과
batch_test_results.json
test_tavily_qwen_result.txt
# Qwen 검열·거절 프로브용 로컬 프롬프트 목록 (예시는 tests/fixtures/qwen_probe_prompts.example.json)
tests/fixtures/qwen_probe_prompts.json
scripts/qwen_probe_results.jsonl

# Tuya / 로컬 기기 덤프 (비밀·환경별)
devices.json
tinytuya.json
tuya-raw.json
snapshot.json

# 봇이 저장한 일회성 도구 (코어 스크립트는 agent_tools/*.py 루트 유지)
# `**/` 로 중첩 경로(tools/runtime/agent_tools/agent_tools/saved/)까지 잡는다.
# 슬래시가 든 패턴은 .gitignore 위치에 고정되어 루트만 매칭됐다.
**/agent_tools/saved/*
!**/agent_tools/saved/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
yunsur_v4_adapter/
yunsur_v4_adapter.tgz
yunsur_v5_hub/
outputs/
*.gguf

# 개인 프로필 DB (Boardroom) — 절대 커밋 금지
CEO_Profile.sqlite
